{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://global-fusion-digest.local/schemas/kev.schema.json",
  "type": "object",
  "required": ["catalogVersion", "dateReleased", "count", "vulnerabilities"],
  "properties": {
    "catalogVersion": { "type": "string", "minLength": 1 },
    "dateReleased": { "type": "string", "format": "date-time" },
    "count": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "vulnerabilities": {
      "type": "array", "minItems": 1, "maxItems": 100000,
      "items": {
        "type": "object",
        "required": ["cveID", "vendorProject", "product", "vulnerabilityName", "dateAdded", "dueDate", "shortDescription", "requiredAction"],
        "properties": {
          "cveID": { "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$" },
          "vendorProject": { "type": "string", "minLength": 1 },
          "product": { "type": "string", "minLength": 1 },
          "vulnerabilityName": { "type": "string", "minLength": 1 },
          "dateAdded": { "type": "string", "format": "date" },
          "dueDate": { "type": "string", "format": "date" },
          "shortDescription": { "type": "string", "minLength": 1 },
          "requiredAction": { "type": "string", "minLength": 1 },
          "knownRansomwareCampaignUse": { "type": "string" },
          "forensicTriage": { "type": "string" },
          "cwes": { "type": "array", "items": { "type": "string", "pattern": "^CWE-[0-9]+$" } },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
